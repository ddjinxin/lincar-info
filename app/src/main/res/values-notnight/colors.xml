<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- ===== 白天色板（高级灰白：深海蓝主色，无发光，白底卡片） ===== -->
    <!-- 页面背景：高级灰白 -->
    <color name="bg_page">#F5F7FA</color>
    <!-- banner 背景：浅灰 -->
    <color name="bg_banner">#E8ECF1</color>
    <!-- 分隔线：浅灰蓝 -->
    <color name="divider">#D5DCE4</color>
    <!-- 主色：深海蓝 -->
    <color name="accent_cyan">#0077C2</color>
    <!-- 数值白：炭黑文本 -->
    <color name="text_bright">#1A2B3C</color>
    <!-- 数值绿：深绿 -->
    <color name="accent_green">#00875A</color>
    <!-- 标签灰：中灰 -->
    <color name="text_label">#6B7A8D</color>
    <!-- chip 关态文字 -->
    <color name="chip_off_text">#5B6B7E</color>
    <!-- 状态色 -->
    <color name="state_ok">#00875A</color>
    <color name="state_invalid">#8A97A5</color>
    <color name="state_warn">#C77800</color>
    <color name="state_alert">#D32F2F</color>
    <color name="state_alert_deep">#B71C1C</color>
    <color name="state_pm_4">#C62828</color>
    <!-- PM2.5 -->
    <color name="pm_good">#00875A</color>
    <color name="pm_fair">#0077C2</color>
    <!-- 连线 -->
    <color name="line_normal">#0077C2</color>
    <color name="line_alert">#D32F2F</color>
    <color name="line_base_normal">#590077C2</color>
    <color name="line_base_alert">#59D32F2F</color>
    <!-- 圆形标签底：白实底 -->
    <color name="circle_bg">#F2F5F8</color>
    <!-- 卡片底：白实底+浅灰描边 -->
    <color name="card_bg">#FFFFFF</color>
    <!-- 区域底 -->
    <color name="zone_bg">#FFFFFF</color>
    <color name="zone_stroke">#C8D2DC</color>
    <!-- 标签底 -->
    <color name="tag_bg">#F2F5F8</color>
    <color name="tag_stroke">#590077C2</color>
    <!-- 胎压标签描边：深蓝 -->
    <color name="tag_stroke_tire">#591A2B3C</color>
    <!-- chip 底 -->
    <color name="chip_bg">#0F1A2B3C</color>
    <color name="chip_bg_stroke">#291A2B3C</color>
    <color name="chip_on_bg">#140077C2</color>
    <color name="chip_on_stroke">#660077C2</color>
    <!-- 速度环底/描边 -->
    <color name="speed_circle_bg">#0A1A2B3C</color>
    <color name="speed_circle_stroke">#330077C2</color>
    <!-- 发光阴影开关：白天关 -->
    <bool name="glow_enabled">false</bool>
    <!-- 车图资源指向：白天车图 -->
    <drawable name="car_top_sel">@drawable/car_top_day</drawable>
</resources>
