<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_page">

    <!-- ============ 顶部横幅：档位/续航/总里程/机油/燃油 (占10%) ============ -->
    <LinearLayout
        android:id="@+id/banner"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="10"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="@color/bg_banner">

        <!-- 档位 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginEnd="8dp">
            <TextView
                android:id="@+id/tvGear"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="P"
                android:textSize="20sp"
                android:textColor="@color/state_alert"
                android:fontFamily="monospace"
                android:textStyle="bold"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="档位"
                android:textSize="7sp"
                android:textColor="@color/text_label"
                android:letterSpacing="0.3"/>
        </LinearLayout>

        <View android:layout_width="1dp" android:layout_height="24dp" android:background="@color/divider"/>

        <!-- 续航 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="8dp">
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="bottom">
                <TextView
                    android:id="@+id/tvRange"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="503"
                    android:textSize="20sp"
                    android:textColor="@color/text_bright"
                    android:fontFamily="monospace"
                    android:textStyle="bold"/>
                <TextView
                    android:id="@+id/tvRangeUnit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="km"
                    android:textSize="10sp"
                    android:textColor="@color/text_label"
                    android:fontFamily="monospace"
                    android:layout_marginStart="1dp"
                    android:layout_marginBottom="1dp"/>
            </LinearLayout>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="续航里程"
                android:textSize="7sp"
                android:textColor="@color/text_label"
                android:letterSpacing="0.3"/>
        </LinearLayout>

        <View android:layout_width="1dp" android:layout_height="24dp" android:background="@color/divider"/>

        <!-- 总里程 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="8dp">
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="bottom">
                <TextView
                    android:id="@+id/tvOdo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="74,595"
                    android:textSize="20sp"
                    android:textColor="@color/state_ok"
                    android:fontFamily="monospace"
                    android:textStyle="bold"/>
                <TextView
                    android:id="@+id/tvOdoUnit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="km"
                    android:textSize="10sp"
                    android:textColor="@color/text_label"
                    android:fontFamily="monospace"
                    android:layout_marginStart="1dp"
                    android:layout_marginBottom="1dp"/>
            </LinearLayout>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="总里程"
                android:textSize="7sp"
                android:textColor="@color/text_label"
                android:letterSpacing="0.3"/>
        </LinearLayout>

        <View android:layout_width="1dp" android:layout_height="24dp" android:background="@color/divider"/>

        <!-- 燃油 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
android:layout_marginStart="4dp"
            android:layout_marginEnd="8dp">
            <TextView
                android:id="@+id/tvFuel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="81%"
                android:textSize="20sp"
                android:textColor="@color/text_bright"
                android:fontFamily="monospace"
                android:textStyle="bold"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="燃油"
                android:textSize="7sp"
                android:textColor="@color/text_label"
                android:letterSpacing="0.3"/>
        </LinearLayout>

        <View android:layout_width="1dp" android:layout_height="24dp" android:background="@color/divider"/>

        <!-- 机油 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginStart="8dp">
            <TextView
                android:id="@+id/tvOil"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="75%"
                android:textSize="20sp"
                android:textColor="@color/text_bright"
                android:fontFamily="monospace"
                android:textStyle="bold"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="机油寿命"
                android:textSize="7sp"
                android:textColor="@color/text_label"
                android:letterSpacing="0.3"/>
        </LinearLayout>
    </LinearLayout>

    <!-- banner 下方流光动画线 -->
    <com.jingxin.lincarinfo.FlowLineView
        android:layout_width="match_parent"
        android:layout_height="3dp" />

    <!-- ============ 速度+车图区 (占80%) ============ -->
    <FrameLayout
        android:id="@+id/carZone"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="80">

        <ImageView
            android:id="@+id/ivCar"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter"
            android:src="@drawable/car_top_sel"
            android:padding="6dp"
            android:layout_marginStart="30dp"
            android:layout_marginEnd="30dp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="24dp"/>

        <!-- 速度 -->
        <TextView
            android:id="@+id/tvSpeed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0"
            android:textSize="50sp"
            android:textColor="@color/text_bright"
            android:fontFamily="monospace"
            android:textStyle="bold"
            android:shadowColor="@color/accent_cyan"
            android:shadowDx="0" android:shadowDy="0" android:shadowRadius="14"
            android:layout_gravity="center_horizontal|top"
            android:layout_marginTop="8dp"/>

        <!-- 红点+虚线标注层（车图上层、标签下层） -->
        <com.jingxin.lincarinfo.TagLineOverlay
            android:id="@+id/tagLines"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>

        <!-- 左前门窗（圆形：异常才显示，渐隐渐显） -->
        <com.jingxin.lincarinfo.DoorCircleView
            android:id="@+id/tagLFDw"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <!-- 右前门窗 -->
        <com.jingxin.lincarinfo.DoorCircleView
            android:id="@+id/tagRFDw"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <!-- 左后门窗 -->
        <com.jingxin.lincarinfo.DoorCircleView
            android:id="@+id/tagLRDw"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <!-- 右后门窗 -->
        <com.jingxin.lincarinfo.DoorCircleView
            android:id="@+id/tagRRDw"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <!-- 左前胎压（圆形：值+单位两行，呼吸边框） -->
        <com.jingxin.lincarinfo.TireCircleView
            android:id="@+id/tagLFTire"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <!-- 右前胎压 -->
        <com.jingxin.lincarinfo.TireCircleView
            android:id="@+id/tagRFTire"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <!-- 左后胎压 -->
        <com.jingxin.lincarinfo.TireCircleView
            android:id="@+id/tagLRTire"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <!-- 右后胎压 -->
        <com.jingxin.lincarinfo.TireCircleView
            android:id="@+id/tagRRTire"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <!-- 后备箱/尾门（圆形：开时才显示，渐隐渐显） -->
        <com.jingxin.lincarinfo.DoorCircleView
            android:id="@+id/tagTrunk"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </FrameLayout>

    <!-- ============ 空调卡 (占10%) ============ -->
    <LinearLayout
        android:id="@+id/acCard"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="10"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@drawable/bg_card"
        android:layout_marginBottom="10dp"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp">

        <!-- 主驾 / PM2.5 / 副驾 三格 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/bg_zone"
                android:paddingTop="5dp" android:paddingBottom="6dp">
                <TextView
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="主驾" android:textSize="7sp" android:textColor="@color/text_label"/>
                <TextView
                    android:id="@+id/tvTempDriver"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="23.0℃" android:textSize="16sp" android:textColor="@color/text_bright"
                    android:fontFamily="monospace" android:textStyle="bold"/>
            </LinearLayout>

            <Space android:layout_width="8dp" android:layout_height="1dp"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/bg_zone"
                android:paddingTop="5dp" android:paddingBottom="6dp">
                <TextView
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="车内PM2.5" android:textSize="7sp" android:textColor="@color/text_label"/>
                <TextView
                    android:id="@+id/tvPm"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="4" android:textSize="16sp" android:textColor="@color/accent_green"
                    android:fontFamily="monospace" android:textStyle="bold"/>
            </LinearLayout>

            <Space android:layout_width="8dp" android:layout_height="1dp"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/bg_zone"
                android:paddingTop="5dp" android:paddingBottom="6dp">
                <TextView
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="副驾" android:textSize="7sp" android:textColor="@color/text_label"/>
                <TextView
                    android:id="@+id/tvTempPassenger"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="23.0℃" android:textSize="16sp" android:textColor="@color/text_bright"
                    android:fontFamily="monospace" android:textStyle="bold"/>
        </LinearLayout>
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
